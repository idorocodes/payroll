// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
}



enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutMethod {
  BANK
  CRYPTO
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  PAYROLL_PAYOUT
  REFUND
}


model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String       @map("password_hash")
  firstName    String       @map("first_name") @db.VarChar(100)
  lastName     String       @map("last_name") @db.VarChar(100)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships  Membership[]

  @@index([email])
  @@map("users")
}

model Company {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  currency  String   @default("USD") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]
  employees   Employee[]
  payrollRuns PayrollRun[]

  @@index([slug])
  @@map("companies")
}

model Membership {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  role      CompanyRole @default(MEMBER)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId], name: "unique_user_company")
  @@index([userId])
  @@index([companyId])
  @@map("memberships")
}

model Employee {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  firstName String         @map("first_name") @db.VarChar(100)
  lastName  String         @map("last_name") @db.VarChar(100)
  email     String         @db.VarChar(255)
  status    EmployeeStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  compensations Compensation[]
  payrollItems  PayrollItem[]

  @@index([companyId])
  @@index([email])
  @@map("employees")
}

model Compensation {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String       @map("employee_id") @db.Uuid
  amount        Decimal      @db.Decimal(18, 2)
  currency      String       @db.VarChar(10)
  frequency     PayFrequency @default(MONTHLY)
  effectiveFrom DateTime     @map("effective_from") @db.Date
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([effectiveFrom])
  @@map("compensations")
}

model PayrollRun {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal       @default(0) @map("total_gross") @db.Decimal(18, 2)
  totalDeductions Decimal       @default(0) @map("total_deductions") @db.Decimal(18, 2)
  totalNet        Decimal       @default(0) @map("total_net") @db.Decimal(18, 2)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollItems PayrollItem[]

  @@index([companyId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("payroll_runs")
}

model PayrollItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRunId String   @map("payroll_run_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  grossAmount  Decimal  @map("gross_amount") @db.Decimal(18, 2)
  deductions   Decimal  @default(0) @db.Decimal(18, 2)
  netAmount    Decimal  @map("net_amount") @db.Decimal(18, 2)
  currency     String   @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payouts    Payout[]

  @@unique([payrollRunId, employeeId], name: "unique_employee_payroll")
  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_items")
}

model Payout {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollItemId     String       @map("payroll_item_id") @db.Uuid
  amount            Decimal      @db.Decimal(18, 2)
  currency          String       @db.VarChar(10)
  method            PayoutMethod
  provider          String?      @db.VarChar(100)
  providerReference String?      @map("provider_reference") @db.VarChar(255)
  status            PayoutStatus @default(PENDING)
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  payrollItem  PayrollItem   @relation(fields: [payrollItemId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([payrollItemId])
  @@index([status])
  @@index([providerReference])
  @@map("payouts")
}

model Transaction {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payoutId          String?           @map("payout_id") @db.Uuid
  type              TransactionType
  amount            Decimal           @db.Decimal(18, 2)
  currency          String            @db.VarChar(10)
  status            TransactionStatus @default(PENDING)
  provider          String?           @db.VarChar(100)
  providerReference String?           @map("provider_reference") @db.VarChar(255)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  payout Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([payoutId])
  @@index([status])
  @@index([providerReference])
  @@map("transactions")
}